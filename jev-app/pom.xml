<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jev.runtime</groupId>
        <artifactId>jev-agent-runtime</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>jev-app</artifactId>
    <name>jev-app</name>
    <description>Runnable Spring Boot application wiring the whole agent runtime</description>

    <dependencies>
        <dependency>
            <groupId>com.jev.runtime</groupId>
            <artifactId>jev-runtime-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jev.runtime</groupId>
            <artifactId>jev-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jev.runtime</groupId>
            <artifactId>jev-decision-layer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jev.runtime</groupId>
            <artifactId>jev-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jev.runtime</groupId>
            <artifactId>jev-llm-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jev.runtime</groupId>
            <artifactId>jev-mcp-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jev.runtime</groupId>
            <artifactId>jev-a2a</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jev.runtime</groupId>
            <artifactId>jev-eval</artifactId>
        </dependency>
        <!-- AgentScope Harness: the pluggable production agent runtime
             (activated with runtime.engine=agentscope + a model API key) -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
